---
import BaseLayout from './BaseLayout.astro';
interface Props { frontmatter: { title: string; description: string; eyebrow?: string; }; wide?: boolean; }
const { frontmatter, wide = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title={`${frontmatter.title} — Science Skills`} description={frontmatter.description}>
  <div class="doc-shell wrap">
    <aside class="doc-nav" aria-label="Documentation navigation">
      <p class="eyebrow">Field guide</p>
      <a href={`${base}getting-started/`}>Getting started</a>
      <a href={`${base}tools/bib-lint/`}>bib-lint</a>
      <a href={`${base}tools/rebuttal-desk/`}>Rebuttal Desk</a>
      <a href={`${base}evaluation/`}>Evaluation & limitations</a>
      <a href={`${base}about/`}>About Science Skills</a>
    </aside>
    <article class:list={['doc-content', { 'doc-content-wide': wide }]}>
      <p class="eyebrow">{frontmatter.eyebrow ?? 'Science Skills / Field guide'}</p>
      <h1>{frontmatter.title}</h1>
      <p class="doc-lead">{frontmatter.description}</p>
      <div class="prose"><slot /></div>
      <a class="text-link doc-back" href={`${base}#skills`}>← Back to skills</a>
    </article>
  </div>
</BaseLayout>
