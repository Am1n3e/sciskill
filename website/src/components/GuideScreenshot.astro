---
import type { ImageMetadata } from 'astro';
interface Props { image: ImageMetadata; alt: string; caption: string; eager?: boolean; }
const { image, alt, caption, eager = false } = Astro.props;
---
<figure>
  <a href={image.src} aria-label={`Open full-size screenshot: ${alt}`}>
    <img src={image.src} width={image.width} height={image.height} alt={alt} loading={eager ? 'eager' : 'lazy'} decoding="async" />
  </a>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  figure { margin: 24px 0; }
  img { display: block; width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; }
  figcaption { font-size: 12px; color: var(--muted); line-height: 1.7; margin-top: 8px; }
</style>
