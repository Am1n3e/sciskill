---
interface Props { agent: string; cli: string; }
const { agent, cli } = Astro.props;
---
<div class="usage-commands">
  <div>
    <p class="command-label">Ask your agent</p>
    <pre><code>{agent}</code></pre>
  </div>
  <div>
    <p class="command-label">Or run directly</p>
    <pre><code>{cli}</code></pre>
  </div>
</div>

<style>
  .usage-commands { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin: 20px 0; }
  .usage-commands > div { min-width: 0; }
  .command-label { font-size: 11px; font-weight: 650; color: var(--ink); margin: 0 0 8px; }
  pre { margin: 0; background: #f8fafc; height: calc(100% - 28px); }
  code { font-family: var(--mono); white-space: pre-wrap; overflow-wrap: anywhere; }
  @media (max-width: 1100px) { .usage-commands { grid-template-columns: 1fr; } pre { height: auto; } }
</style>
