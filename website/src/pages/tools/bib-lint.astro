---
import DocLayout from '../../layouts/DocLayout.astro';
import UsageCommands from '../../components/UsageCommands.astro';
import GuideScreenshot from '../../components/GuideScreenshot.astro';
import results from '../../assets/bib-lint/results.jpg';
import correct from '../../assets/bib-lint/correct.jpg';
import invalid from '../../assets/bib-lint/invalid.jpg';
import review from '../../assets/bib-lint/needs-review.jpg';
import unresolved from '../../assets/bib-lint/unresolved.jpg';
import partial from '../../assets/bib-lint/partial-match.jpg';
import pdf from '../../assets/bib-lint/pdf-evidence.jpg';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const cases = [
  {
    id: 'invalid', status: 'Invalid', title: 'A source demonstrates a mismatch',
    text: 'This Tulu citation says 2025; the retrieved arXiv record says 2024. The expanded row shows both values and the source link. Check publication versions before accepting a correction.',
    key: 'pdf-ref-0011',
    agent: 'Show pdf-ref-0011 in paper-audit. Explain the year mismatch and link to the source.',
    image: invalid,
    alt: 'Expanded Invalid Tulu reference showing a suggested year correction from 2025 to 2024 and the arXiv evidence link.',
    caption: 'Suggested corrections are proposals. The input file has not been edited.',
  },
  {
    id: 'correct', status: 'Correct', title: 'The checked fields match',
    text: 'The offline reinforcement learning reference matches the retrieved record. Matching fields are visible by default. “Found” means a source returned a record; “Correct” is the reference decision.',
    key: 'pdf-ref-0012',
    agent: 'Show pdf-ref-0012 in paper-audit and its matching fields and source evidence.',
    image: correct,
    alt: 'Expanded Correct reference with matching title, authors, year, and arXiv identifier, plus one arXiv source check.',
    caption: 'Only the sources actually checked appear here. One match does not imply agreement from other providers.',
  },
  {
    id: 'needs-review', status: 'Needs review', title: 'A record was found, but a field is uncertain',
    text: 'High Confidence Policy Improvement has an author-name difference that the audit cannot confidently resolve. The field is marked “Insufficient data” instead of being declared wrong.',
    key: 'pdf-ref-0019',
    agent: 'Show pdf-ref-0019 in paper-audit. Explain what remains uncertain without changing the citation.',
    image: review,
    alt: 'Expanded Needs review reference showing uncertain author names, a PMLR record found, and the other source-search outcomes.',
    caption: 'A found record can still leave citation fields unverified.',
  },
  {
    id: 'unresolved', status: 'Unresolved', title: 'No unambiguous authoritative record was found',
    text: 'This example’s saved searches did not resolve Bayesian Data Analysis. That is a lookup limitation, not evidence that the book is fabricated.',
    key: 'pdf-ref-0005',
    agent: 'Show pdf-ref-0005 in paper-audit and summarize the lookup limitations.',
    image: unresolved,
    alt: 'Expanded Unresolved Bayesian Data Analysis reference showing no demonstrated field differences and six source searches with no matching record.',
    caption: 'Provider coverage and missing identifiers can leave real publications unresolved.',
  },
];
---
<DocLayout wide frontmatter={{
  title: 'BibLint, in practice',
  description: 'Check a PDF reference list or BibTeX file. Open the results. Follow each finding back to its evidence.',
  eyebrow: 'SciSkill / Reference auditing',
}}>
  <div class="bib-lint-guide">
    <nav class="guide-jumps" aria-label="On this page">
      <a href="#start">Run an audit</a><a href="#viewer">Open the viewer</a><a href="#findings">Read a finding</a><a href="#retry">Recheck a reference</a>
    </nav>

    <section id="start">
      <h2>1. Check your references</h2>
      <p>Check <code>paper.pdf</code> or <code>references.bib</code> with the same command.</p>
      <p class="input-note"><strong>Recommended:</strong> Use the <code>.bib</code> file when available to avoid PDF extraction issues.</p>
      <UsageCommands
        agent={'/sciskill bib-lint paper.pdf\nSave the audit in paper-audit.'}
        cli={'uvx sciskill bib-lint verify paper.pdf \\\n  --output paper-audit --json'}
      />
    </section>

    <section id="viewer">
      <h2>2. Open the results</h2>
      <UsageCommands
        agent="Open the BibLint report in paper-audit so I can inspect the findings."
        cli="uvx sciskill bib-lint view paper-audit"
      />
      <GuideScreenshot image={results} eager
        alt="BibLint viewer with a summary table of 20 extracted and processed references, result counts, search filters, and the reference table immediately below."
        caption="The summary covers the whole audit. Search and Needs attention filter the reference rows, not those totals. Select a title to expand its checks in place."
      />
      <p class="example-note">These screenshots use public-reference test cases with recorded source responses and deliberately altered citations. Paths are shortened. Live results may differ; the example keys below are not keys for your own PDF.</p>
    </section>

    <section id="findings">
      <h2>3. Read a finding</h2>
      <p>Choose an example. Each shows one expanded reference with its comparisons and sources. If your viewer is already open, select the indicated key there.</p>
      {cases.map(example => (
        <details class="finding-example" id={example.id} open={example.id === 'invalid'}>
          <summary><span class={`finding-status ${example.id}`}>{example.status}</span><span>{example.title}</span></summary>
          <p>{example.text}</p>
          <UsageCommands agent={example.agent} cli={`uvx sciskill bib-lint view paper-audit\n# Select ${example.key} in the table.`} />
          <GuideScreenshot image={example.image} alt={example.alt} caption={example.caption} />
        </details>
      ))}

      <details class="finding-example" id="partial-match">
        <summary><span class="finding-status partial-match">Partial match</span><span>The printed author list is abbreviated</span></summary>
        <p>In a separate PDF example, “Tanmay Gupta; others” matches the start of the CodeNav author list. It does not verify the omitted authors.</p>
        <UsageCommands
          agent="Audit truncated-authors.pdf into authors-audit, then show the partial author match in pdf-ref-0027."
          cli={'uvx sciskill bib-lint verify truncated-authors.pdf \\\n  --output authors-audit --json\nuvx sciskill bib-lint view authors-audit\n# Select pdf-ref-0027 in this example.'}
        />
        <GuideScreenshot image={partial}
          alt="Expanded Partial match CodeNav reference comparing Tanmay Gupta and others with the complete three-author arXiv record."
          caption="Partial match acknowledges abbreviated evidence instead of upgrading it to a full match."
        />
      </details>

      <details class="finding-example" id="pdf-evidence">
        <summary><span class="finding-status">PDF evidence</span><span>Check what was actually printed</span></summary>
        <p>Expand <strong>PDF evidence</strong> beneath a reference to see the original text fragments, physical page numbers, and field provenance.</p>
        <UsageCommands
          agent="Show the original PDF evidence for pdf-ref-0019 in paper-audit."
          cli={'uvx sciskill bib-lint view paper-audit\n# Select pdf-ref-0019, then PDF evidence.'}
        />
        <GuideScreenshot image={pdf}
          alt="PDF evidence for High Confidence Policy Improvement showing interpreted text, four original fragments, and physical page 2 locations."
          caption="Here the printed name is split across lines. Retrieved metadata never fills missing input fields before comparison."
        />
      </details>

      <table class="other-states">
        <thead><tr><th scope="col">Also visible</th><th scope="col">Meaning</th></tr></thead>
        <tbody>
          <tr><th scope="row">Pending</th><td>Verification has not finished for this reference.</td></tr>
          <tr><th scope="row">Skipped</th><td>The AUX file marks the BibTeX entry as unused.</td></tr>
          <tr><th scope="row">Failed source</th><td>A lookup failed. This alone does not make the reference Invalid.</td></tr>
        </tbody>
      </table>
    </section>

    <section id="retry">
      <h2>4. Recheck one reference</h2>
      <p>Rerunning the original audit resumes unfinished work and preserves saved outcomes. Use <code>--refresh</code> to fetch sources again; <code>--key</code> limits the recheck.</p>
      <UsageCommands
        agent="Retry the source lookups for pdf-ref-0019 in paper-audit and show me what changed."
        cli={'uvx sciskill bib-lint verify paper.pdf \\\n  --output paper-audit \\\n  --key pdf-ref-0019 --refresh --json'}
      />
      <p class="boundary-note">A finished audit does not certify complete PDF extraction. Review extraction warnings; scanned reference lists need OCR outside BibLint. Metadata checks do not establish whether a paper supports your scientific claim.</p>
      <p><a href="https://github.com/Am1n3e/sciskill/blob/main/tools/bib-lint/README.md">Full CLI reference</a> · <a href={`${base}evaluation/`}>Evaluation &amp; limitations</a></p>
    </section>
  </div>
</DocLayout>

<style>
  :global(.doc-content-wide) { max-width: none; min-width: 0; }
  .guide-jumps { display: flex; gap: 12px 24px; flex-wrap: wrap; margin-bottom: 28px; font-size: 12px; }
  section { scroll-margin-top: 24px; }
  .input-note { border-left: 2px solid var(--line); padding-left: 16px; font-size: 14px; }
  .example-note, .boundary-note { font-size: 12px; }
  .example-note { border-left: 2px solid var(--line); padding-left: 16px; }
  details { border: 1px solid var(--line); border-radius: 4px; padding: 16px; margin: 12px 0; }
  summary { cursor: pointer; color: var(--ink); font-size: 13px; }
  summary:focus-visible { outline: 2px solid var(--ink); outline-offset: 5px; }
  .finding-status { display: inline-block; font-size: 12px; font-weight: 650; margin: 0 12px 0 6px; }
  .correct { color: #246048; }
  .invalid { color: #9d2940; }
  .needs-review, .partial-match { color: #684790; }
  .unresolved { color: #475569; }
  :global(.prose .other-states th) { white-space: nowrap; }
  @media (max-width: 760px) {
    .guide-jumps { gap: 8px 16px; }
    details { padding: 12px; }
    summary { line-height: 1.8; }
  }
</style>
