---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout>
  <section class="hero wrap">
    <div class="hero-copy">
      <h1>Agent skills and tools for scientists.</h1>
      <p class="hero-description">Keep your focus on the science. Let your agent handle the grunt work.</p>
    </div>
    <div class="hero-art"><img src={`${base}images/scientist-robot-transformer.png`} alt="A scientist writes Transformer attention equations on a whiteboard while a small robot sweeps up chalk dust" width="1536" height="1024" fetchpriority="high" /></div>
  </section>

  <section class="wrap skill-install" aria-label="Install Science Skills">
    <div class="install-command"><code>npx skills add Am1n3e/sciskill</code><button type="button" class="install-copy" data-copy="npx skills add Am1n3e/sciskill" aria-label="Copy Science Skills installation command" data-icon-copy><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg></button></div>
  </section>

  <section id="skills" class="skill-action wrap section-anchor" aria-labelledby="init-heading">
    <div class="action-copy"><p class="eyebrow">01 / Setup</p><h2 id="init-heading">Initialize</h2><p>Run the standalone command to see the available tools and actions.</p></div>
    <div class="agent-terminal" aria-label="Initialization usage"><div class="agent-terminal-command"><span class="agent-prompt" aria-hidden="true">›</span><code>uvx sciskill init</code></div><pre class="agent-terminal-output">Project configuration is ready.</pre></div>
  </section>

  <section class="skill-action wrap section-anchor" aria-labelledby="references-heading">
    <div class="action-copy"><p class="eyebrow">02 / Reference checking</p><h2 id="references-heading">bib-lint</h2><p>Check your bibliography against scholarly records. Inspect metadata differences alongside the source evidence, without changing your bibliography.</p>
    <a class="text-link" href={`${base}tools/bib-lint/`}>Explore reference checking <span aria-hidden="true">↗</span></a></div>
    <div class="agent-terminal" aria-label="bib-lint usage"><div class="agent-terminal-command"><span class="agent-prompt" aria-hidden="true">›</span><code>uvx sciskill bib-lint verify paper.bib</code></div><pre class="agent-terminal-output">Audit complete.
Open the report to review findings and source evidence.</pre></div>
  </section>

  <section class="skill-action wrap section-anchor" aria-labelledby="rebuttal-heading">
    <div class="action-copy"><p class="eyebrow">03 / Review & response planning</p><h2 id="rebuttal-heading">Plan your rebuttal.</h2><p>Turn reviewer feedback into a response plan. Bring related concerns together, identify the evidence each answer needs, and keep every response connected to the original review.</p>
    <a class="text-link" href={`${base}tools/rebuttal-desk/`}>Explore rebuttal planning <span aria-hidden="true">↗</span></a></div>
    <div class="agent-terminal" aria-label="Rebuttal planning usage"><div class="agent-terminal-command"><span class="agent-prompt" aria-hidden="true">›</span><code>/sciskill plan-rebuttal reviews.md</code></div><pre class="agent-terminal-output">Response plan ready.
Review concerns, supporting evidence, and proposed responses.</pre></div>
  </section>

  <p id="copy-status" class="sr-only" role="status" aria-live="polite"></p>

  <script>
    const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-copy]');
    const copyStatus = document.getElementById('copy-status');
    copyButtons.forEach((copy) => {
      const originalMarkup = copy.innerHTML;
      const originalLabel = copy.getAttribute('aria-label') ?? 'Copy commands';
      copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copy.dataset.copy ?? '');
        if (!copy.hasAttribute('data-icon-copy')) copy.textContent = 'Copied ✓';
        copy.setAttribute('aria-label', 'Copied to clipboard');
        copy.title = 'Copied to clipboard';
        if (copyStatus) copyStatus.textContent = 'Commands copied.';
        window.setTimeout(() => { copy.innerHTML = originalMarkup; copy.setAttribute('aria-label', originalLabel); copy.removeAttribute('title'); }, 2200);
      } catch {
        if (copyStatus) copyStatus.textContent = 'Clipboard is unavailable. Select and copy the commands below.';
        copy.setAttribute('aria-label', 'Clipboard unavailable. Select and copy the command.');
        copy.title = 'Clipboard unavailable. Select and copy the command.';
        if (!copy.hasAttribute('data-icon-copy')) copy.textContent = 'Select commands below';
      }
      });
    });
  </script>
</BaseLayout>
